{% extends 'base.html.twig' %}

{% block title %}Edit Room{% endblock %}

{% block body %}
    {% include 'components/_header.html.twig' %}
    <div class="content-wrapper">
        <h1>Edit Room</h1>

        {{ include('room/_form.html.twig', {'button_label': 'Update'}) }}

        {% if is_granted('room_index_view') %}
            <a href="{{ path('app_room_index') }}">back to list</a>
        {% endif %}

        {% if is_granted('room_delete', room) %}
            {{ include('room/_delete_form.html.twig') }}
        {% endif %}
    </div>
    {% include 'components/_footer.html.twig' %}
{% endblock %}
