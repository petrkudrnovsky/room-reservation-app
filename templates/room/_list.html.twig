<table class="table">
    <thead>
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Code</th>
        <th>IsPrivate</th>
        <th>actions</th>
    </tr>
    </thead>
    <tbody>
    {% for room in rooms %}
        <tr>
            <td>{{ room.id }}</td>
            <td>{{ room.name }}</td>
            <td>{{ room.codeName }}</td>
            <td>{{ room.isPrivate ? 'Yes' : 'No' }}</td>
            <td>{{ room.isLocked ? 'Yes' : 'No' }}</td>
            <td>
                {% if is_granted('room_detail_view', room) %}
                    <a href="{{ path('app_room_show', {'id': room.id}) }}">show</a>
                {% endif %}
                {% if is_granted('room_edit', room) %}
                    <a href="{{ path('app_room_edit', {'id': room.id}) }}">edit</a>
                {% endif %}
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="5">no records found</td>
        </tr>
    {% endfor %}
    </tbody>
</table>