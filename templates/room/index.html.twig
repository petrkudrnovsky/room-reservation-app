{% extends 'base.html.twig' %}

{% block title %}Room index{% endblock %}

{% block body %}
    {% include 'components/_header.html.twig' %}
    <div class="content-wrapper">
        <h1>Room index</h1>

        <table class="table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Code</th>
                    <th>IsPrivate</th>
                    <th>actions</th>
                </tr>
            </thead>
            <tbody>
            {% for room in rooms %}
                <tr>
                    <td>{{ room.id }}</td>
                    <td>{{ room.name }}</td>
                    <td>{{ room.codeName }}</td>
                    <td>{{ room.isPrivate ? 'Yes' : 'No' }}</td>
                    <td>
                        <a href="{{ path('app_room_show', {'id': room.id}) }}">show</a>
                        <a href="{{ path('app_room_edit', {'id': room.id}) }}">edit</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <a href="{{ path('app_room_new') }}">Create new</a>
    </div>
    {% include 'components/_footer.html.twig' %}
{% endblock %}
