<table class="table">
    <thead>
    <tr>
        <th>Id</th>
        <th>Title</th>
        <th>Description</th>
        <th>Start</th>
        <th>End</th>
        <th>Status</th>
        <th>actions</th>
    </tr>
    </thead>
    <tbody>
    {% for reservation in reservations %}
        <tr>
            <td>{{ reservation.id }}</td>
            <td>{{ reservation.title }}</td>
            <td>{{ reservation.description|default('') }}</td>
            <td>{{ reservation.startDatetime ? reservation.startDatetime|date('d. m. Y H:i:s') : '' }}</td>
            <td>{{ reservation.endDatetime ? reservation.endDatetime|date('d. m. Y H:i:s') : '' }}</td>
            <td>{{ reservation.status }}</td>
            <td>
                <a href="{{ path('app_room_reservation_show', {'id': reservation.id, 'roomId': reservation.room.id}) }}">show</a>
                <a href="{{ path('app_room_reservation_edit', {'id': reservation.id, 'roomId': reservation.room.id}) }}">edit</a>
                {% if reservation.status == 'pending' %}
                    {% include 'reservation/_approve.html.twig' %}
                    {% include 'reservation/_reject.html.twig' %}
                {% endif %}
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="5">No records found</td>
        </tr>
    {% endfor %}
    </tbody>
</table>