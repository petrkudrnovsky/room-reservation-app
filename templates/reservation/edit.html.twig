{% extends 'base.html.twig' %}

{% block title %}Edit Reservation{% endblock %}

{% block body %}
    {% include 'components/_header.html.twig' %}
    <div class="content-wrapper">
        <h1>Edit Reservation (room {{ reservation.room.codeName }})</h1>

        {{ include('reservation/_form.html.twig', {'button_label': 'Update'}) }}

        <a href="{{ path('app_room_reservation_index', {'roomId': reservation.room.id}) }}">back to list</a>

        {{ include('reservation/_delete_form.html.twig') }}
    </div>
    {% include 'components/_footer.html.twig' %}
{% endblock %}
