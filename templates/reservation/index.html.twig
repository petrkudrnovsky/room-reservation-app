{% extends 'base.html.twig' %}

{% block title %}Reservation index{% endblock %}

{% block body %}
    {% include 'components/_header.html.twig' %}
    <div class="content-wrapper">
        <h1>Reservation index</h1>

        <table class="table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Start</th>
                    <th>EndTime</th>
                    <th>Status</th>
                    <th>actions</th>
                </tr>
            </thead>
            <tbody>
            {% for reservation in reservations %}
                <tr>
                    <td>{{ reservation.id }}</td>
                    <td>{{ reservation.title }}</td>
                    <td>{{ reservation.description|default('Not included') }}</td>
                    <td>{{ reservation.startDatetime ? reservation.startDatetime|date('Y-m-d H:i:s') : '' }}</td>
                    <td>{{ reservation.endDatetime ? reservation.endDatetime|date('Y-m-d H:i:s') : '' }}</td>
                    <td>{{ reservation.status }}</td>
                    <td>
                        <a href="{{ path('app_reservation_show', {'id': reservation.id}) }}">show</a>
                        <a href="{{ path('app_reservation_edit', {'id': reservation.id}) }}">edit</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <a href="{{ path('app_reservation_new') }}">Create new</a>
    </div>
    {% include 'components/_footer.html.twig' %}
{% endblock %}
