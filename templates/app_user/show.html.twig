{% extends 'base.html.twig' %}

{% block title %}AppUser{% endblock %}

{% block body %}
    {% include 'components/_header.html.twig' %}
    <div class="content-wrapper user__profile">
        <div class="user__profile">
            <h1>User: {{ app_user.firstName }} {{ app_user.secondName }}</h1>

            <table class="table">
                <tbody>
                    <tr>
                        <th>Username</th>
                        <td>{{ app_user.username }}</td>
                    </tr>
                    <tr>
                        <th>Roles</th>
                        <td>{{ app_user.roles ? app_user.roles|json_encode : '' }}</td>
                    </tr>
                    <tr>
                        <th>First name</th>
                        <td>{{ app_user.firstName }}</td>
                    </tr>
                    <tr>
                        <th>Second name</th>
                        <td>{{ app_user.secondName }}</td>
                    </tr>
                    <tr>
                        <th>Email</th>
                        <td>{{ app_user.email }}</td>
                    </tr>
                    <tr>
                        <th>Phone</th>
                        <td>{{ app_user.phone }}</td>
                    </tr>
                    <tr>
                        <th>Member of these rooms:</th>
                        <td>
                            <ul>
                                {% for room in app_user.memberRooms %}
                                    <li>
                                        <a href="{{ path('app_room_show', {'id': room.id}) }}">{{ room.codeName }}</a>
                                    </li>
                                {% else %}
                                    <li>No rooms found</li>
                                {% endfor %}
                                <hr>
                            </ul>
                        </td>
                    </tr>
                    <tr>
                        <th>Admin of these rooms:</th>
                        <td>
                            <ul>
                                {% for room in app_user.adminRooms %}
                                    <li>
                                        <a href="{{ path('app_room_show', {'id': room.id}) }}">{{ room.codeName }}</a>
                                    </li>
                                {% else %}
                                    <li>No rooms found</li>
                                {% endfor %}
                                <hr>
                            </ul>
                        </td>
                    </tr>
                    <tr>
                        <th>Member of these groups:</th>
                        <td>
                            <ul>
                                {% for group in app_user.memberGroups %}
                                    <li>
                                        <a href="{{ path('app_group_show', {'id': group.id}) }}">{{ group.name }}</a>
                                    </li>
                                {% else %}
                                    <li>No groups found</li>
                                {% endfor %}
                                <hr>
                            </ul>
                        </td>
                    </tr>
                    <tr>
                        <th>Admin of these groups:</th>
                        <td>
                            <ul>
                                {% for group in app_user.adminGroups %}
                                    <li>
                                        <a href="{{ path('app_group_show', {'id': group.id}) }}">{{ group.name }}</a>
                                    </li>
                                {% else %}
                                    <li>No groups found</li>
                                {% endfor %}
                            </ul>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="form__button-wrapper">
            {% if is_granted('app_index_view', app_user) %}
                <a href="{{ path('app_user_index') }}">back to list</a>
            {% endif %}
            {% if is_granted('user_edit', app_user) %}
                <a href="{{ path('app_user_edit', {'id': app_user.id}) }}">edit</a>
            {% endif %}
            {% if is_granted('user_delete', app_user) %}
                {{ include('app_user/_delete_form.html.twig') }}
            {% endif %}
        </div>
    </div>
    {% include 'components/_footer.html.twig' %}
{% endblock %}
