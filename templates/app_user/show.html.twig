{% extends 'base.html.twig' %}

{% block title %}AppUser{% endblock %}

{% block body %}
    {% include 'components/_header.html.twig' %}
    <div class="content-wrapper user__profile">
        <div class="user__profile">
            <h1>User: {{ app_user.firstName }} {{ app_user.secondName }}</h1>

            <table class="table">
                <tbody>
                    <tr>
                        <th>Id</th>
                        <td>{{ app_user.id }}</td>
                    </tr>
                    <tr>
                        <th>Username</th>
                        <td>{{ app_user.username }}</td>
                    </tr>
                    <tr>
                        <th>Password</th>
                        <td>{{ app_user.password }}</td>
                    </tr>
                    <tr>
                        <th>Roles</th>
                        <td>{{ app_user.roles ? app_user.roles|json_encode : '' }}</td>
                    </tr>
                    <tr>
                        <th>First name</th>
                        <td>{{ app_user.firstName }}</td>
                    </tr>
                    <tr>
                        <th>Second name</th>
                        <td>{{ app_user.secondName }}</td>
                    </tr>
                    <tr>
                        <th>Email</th>
                        <td>{{ app_user.email }}</td>
                    </tr>
                    <tr>
                        <th>Phone</th>
                        <td>{{ app_user.phone }}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="form__button-wrapper">
            <a href="{{ path('app_user_index') }}">back to list</a>

            <a href="{{ path('app_user_edit', {'id': app_user.id}) }}">edit</a>

            {{ include('app_user/_delete_form.html.twig') }}
        </div>
    </div>
    {% include 'components/_footer.html.twig' %}
{% endblock %}
