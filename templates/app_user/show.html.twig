{% extends 'base.html.twig' %}

{% block title %}AppUser{% endblock %}

{% block body %}
    {% if is_granted('app_index_view', app_user) %}
        <a href="{{ path('app_user_index') }}" class="back-link">Back to list</a>
    {% endif %}
    <main class="user__profile">
        <section class="user-info">
            <h2>User: {{ app_user.firstName }} {{ app_user.secondName }}</h2>
            <div class="info-item">
                <span>Username:</span>
                <span>{{ app_user.username }}</span>
            </div>
            <div class="info-item">
                <span>Roles:</span>
                <div>
                    {% for role in app_user.roles %}
                        <span class="badge badge-{{ role }}">{{ role }}</span>
                    {% endfor %}
                </div>
            </div>
            <div class="info-item">
                <span>First name:</span>
                <span>{{ app_user.firstName }}</span>
            </div>
            <div class="info-item">
                <span>Second name:</span>
                <span>{{ app_user.secondName }}</span>
            </div>
            <div class="info-item">
                <span>Email:</span>
                <span>{{ app_user.email }}</span>
            </div>
            <div class="info-item">
                <span>Phone:</span>
                <span>{{ app_user.phone }}</span>
            </div>
            <aside class="user-rooms">
                <div class="tag-item">
                    <span>Member of these rooms:</span>
                    <ul>
                        {% for room in app_user.memberRooms %}
                            <li>
                                <a href="{{ path('app_room_show', {'id': room.id}) }}">{{ room.codeName }}</a>
                            </li>
                        {% else %}
                            <li>No rooms found</li>
                        {% endfor %}
                    </ul>
                </div>
                <div class="tag-item">
                    <span>Admin of these rooms:</span>
                    <ul>
                        {% for room in app_user.adminRooms %}
                            <li>
                                <a href="{{ path('app_room_show', {'id': room.id}) }}">{{ room.codeName }}</a>
                            </li>
                        {% else %}
                            <li>No rooms found</li>
                        {% endfor %}
                    </ul>
                </div>
                <div class="tag-item">
                    <span>Member of these groups:</span>
                    <ul>
                        {% for group in app_user.memberGroups %}
                            <li>
                                <a href="{{ path('app_group_show', {'id': group.id}) }}">{{ group.name }}</a>
                            </li>
                        {% else %}
                            <li>No groups found</li>
                        {% endfor %}
                    </ul>
                </div>
                <div class="tag-item">
                    <span>Admin of these groups:</span>
                    <ul>
                        {% for group in app_user.adminGroups %}
                            <li>
                                <a href="{{ path('app_group_show', {'id': group.id}) }}">{{ group.name }}</a>
                            </li>
                        {% else %}
                            <li>No groups found</li>
                        {% endfor %}
                    </ul>
                </div>
            </aside>
            <div class="actions">
                {% if is_granted('user_edit', app_user) %}
                    <a href="{{ path('app_user_edit', {'id': app_user.id}) }}" class="action-link">Edit</a>
                {% endif %}
                {% if is_granted('user_delete', app_user) %}
                    {{ include('app_user/_delete_form.html.twig') }}
                {% endif %}
            </div>
        </section>
        <div class="reservations">
            <h2>My reservations</h2>
            {{ include('reservation/_list.html.twig', {'reservations': app_user.reservations}) }}
        </div>
    </main>
{% endblock %}
