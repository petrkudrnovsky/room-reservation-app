{% extends 'base.html.twig' %}

{% block title %}Group{% endblock %}

{% block body %}
    {% include 'components/_header.html.twig' %}
    <div class="content-wrapper">
        <h1>Group</h1>

        <table class="table">
            <tbody>
                <tr>
                    <th>Name</th>
                    <td>{{ group.name }}</td>
                </tr>
                <tr>
                    <th>Members</th>
                    <td>
                        <ul>
                            {% for member in group.members %}
                                <li>{{ member.username }}</li>
                            {% endfor %}
                        </ul>
                        <hr>
                    </td>
                </tr>
                <tr>
                    <th>Admins</th>
                    <td>
                        <ul>
                            {% for admin in group.admins %}
                                <li>{{ admin.username }}</li>
                            {% endfor %}
                        </ul>
                        <hr>
                    </td>
                </tr>
                <tr>
                    <th>Rooms</th>
                    <td>
                        <ul>
                            {% for room in group.rooms %}
                                <li>{{ room.name }}</li>
                            {% endfor %}
                        </ul>
                        <hr>
                    </td>
            </tbody>
        </table>

        {% if is_granted('group_index_view') %}
            <a href="{{ path('app_group_index') }}">back to list</a>
        {% endif %}
        {% if is_granted('group_edit', group) %}
            <a href="{{ path('app_group_edit', {'id': group.id}) }}">edit</a>
        {% endif %}
        {% if is_granted('group_delete', group) %}
            {{ include('group/_delete_form.html.twig') }}
        {% endif %}
    </div>
    {% include 'components/_footer.html.twig' %}
{% endblock %}
